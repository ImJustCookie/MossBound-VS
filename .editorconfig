root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props}]
indent_size = 2

[assets/**/*.json]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Rules marked `warning` are enforced: `dotnet format --verify-no-changes` (CI and the pre-commit hook)
# fails on them, and `dotnet format` fixes most of them.
[*.cs]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.IDE0005.severity = warning   # unused using
dotnet_diagnostic.IDE0055.severity = warning   # formatting (spacing, indentation, using order)
dotnet_diagnostic.IDE0161.severity = warning   # file-scoped namespace

csharp_new_line_before_open_brace = all
csharp_prefer_braces = when_multiline:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0044.severity = warning   # field could be readonly
dotnet_diagnostic.IDE0051.severity = warning   # unused private member
dotnet_diagnostic.IDE0052.severity = warning   # private member assigned but never read
dotnet_diagnostic.IDE0060.severity = warning   # unused parameter

# Names: PascalCase types and members, camelCase locals, parameters and private fields.
dotnet_naming_rule.private_fields_camel.symbols = private_fields
dotnet_naming_rule.private_fields_camel.style = camel
dotnet_naming_rule.private_fields_camel.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_rule.private_consts_pascal.symbols = private_consts
dotnet_naming_rule.private_consts_pascal.style = pascal
dotnet_naming_rule.private_consts_pascal.severity = warning
dotnet_naming_symbols.private_consts.applicable_kinds = field
dotnet_naming_symbols.private_consts.applicable_accessibilities = private
dotnet_naming_symbols.private_consts.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case
