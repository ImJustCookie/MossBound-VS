<Project>
  <PropertyGroup>
    <!-- The .editorconfig style rules show up as build warnings, in the editor and in CI. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Unused usings (IDE0005) are checked by `dotnet format` instead: the build would need an XML docs file for it. -->
    <NoWarn>$(NoWarn);EnableGenerateDocumentationFile</NoWarn>
  </PropertyGroup>
</Project>
