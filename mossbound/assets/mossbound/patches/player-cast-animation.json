// Player poses for a held medium (ItemCircleMedium):
// - mossbound-hold: the vanilla item-ready pose (elbow at the side), forearm raised a little more.
// - mossbound-cast: the hand a little higher while casting. 300 frames (10 s) with the pose repeated at the last
//   frame: the cast is held until release, and the game treats a use animation past 95% as finished and restarts it.
// - mossbound-ready: the hold pose played once after a use and on switching items, then eased out; it needs its
//   own code, because the game stops the ready animation by code and would stop the hold pose with it.
// - the -fp variants: the same, seen from the eyes in first person (the game picks them by suffix). The arm is
//   offset like vanilla helditemready-fp and raised so the medium sits low right on screen. The cast pose is the hold
//   pose lifted 5 degrees with the same elbow bend: it stays at full weight for as long as the button is held, and the
//   game crossfades it with hold, so a different arm shape shows as the arm swinging out.
// ItemAnchor (the hand bone) is counter-rotated so its X axis stays vertical whatever the arm does:
// ItemCircleMedium.OnBeforeRender spins the medium around that axis, and the hand transforms lift along it.
// Change an arm angle and the ItemAnchor angles must be solved again with tools/pose-preview/solve.py and checked with pose.py.
// Each keyframe gives all three axes of what it sets, or the game crashes reading a missing value.
// Spin and float are done in code, not here: a blended animation unwinds its rotation backwards when it ends.
[
	{
		file: "game:shapes/entity/humanoid/seraph-faceless.json",
		op: "add",
		path: "/animations/-",
		value: {
			name: "Mossbound hold", code: "mossbound-hold", quantityframes: 30,
			onActivityStopped: "EaseOut", onAnimationEnd: "Repeat",
			keyframes: [
				{ frame: 0, elements: {
					UpperArmR: { rotationX: 8, rotationY: -2, rotationZ: -17 },
					LowerArmR: { rotationX: -8, rotationY: 0, rotationZ: -45 },
					ItemAnchor: { rotationX: -5, rotationY: 0, rotationZ: -26 }
				} }
			]
		}
	},
	{
		file: "game:shapes/entity/humanoid/seraph-faceless.json",
		op: "add",
		path: "/animations/-",
		value: {
			name: "Mossbound cast", code: "mossbound-cast", quantityframes: 300,
			onActivityStopped: "EaseOut", onAnimationEnd: "Hold",
			keyframes: [
				{ frame: 0, elements: {
					UpperArmR: { rotationX: 8, rotationY: -2, rotationZ: -17 },
					LowerArmR: { rotationX: -8, rotationY: 0, rotationZ: -45 },
					ItemAnchor: { rotationX: -5, rotationY: 0, rotationZ: -26 },
					Head: { rotationX: 0, rotationY: 0, rotationZ: 0 }
				} },
				{ frame: 10, elements: {
					UpperArmR: { rotationX: 8, rotationY: -2, rotationZ: -25 },
					LowerArmR: { rotationX: -8, rotationY: 0, rotationZ: -60 },
					ItemAnchor: { rotationX: -40, rotationY: 0, rotationZ: -4 },
					Head: { rotationX: 0, rotationY: 0, rotationZ: 8 }
				} },
				{ frame: 299, elements: {
					UpperArmR: { rotationX: 8, rotationY: -2, rotationZ: -25 },
					LowerArmR: { rotationX: -8, rotationY: 0, rotationZ: -60 },
					ItemAnchor: { rotationX: -40, rotationY: 0, rotationZ: -4 },
					Head: { rotationX: 0, rotationY: 0, rotationZ: 8 }
				} }
			]
		}
	},
	{
		file: "game:entities/humanoid/player.json",
		op: "add",
		path: "/client/animations/-",
		value: {
			code: "mossbound-hold", animation: "mossbound-hold", easeInSpeed: 4, easeOutSpeed: 4, blendMode: "Add",
			elementWeight: { UpperArmR: 20, LowerArmR: 20, ItemAnchor: 20 },
			elementBlendMode: { UpperArmR: "AddAverage", LowerArmR: "AddAverage", ItemAnchor: "AddAverage" }
		}
	},
	{
